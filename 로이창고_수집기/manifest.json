{
  "manifest_version": 3,
  "name": "로이창고 상품 수집기",
  "version": "2.2.1",
  "description": "타오바오·티몰·1688·라쿠텐·퍼센티·온채널·오너클랜·도매매 상품을 한 번에 담고, 천조직구 배송대행 신청서까지 채워 줍니다.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "로이창고 수집함",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://item.taobao.com/*",
        "https://detail.tmall.com/*",
        "https://detail.1688.com/*",
        "https://item.rakuten.co.jp/*",
        "https://s.taobao.com/*",
        "https://s.1688.com/*",
        "https://search.rakuten.co.jp/*",
        "https://www.rakuten.co.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.percenty.co.kr/*",
        "https://percenty.co.kr/*"
      ],
      "js": [
        "percenty.js"
      ],
      "css": [
        "percenty.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.onch.co.kr/*",
        "https://onch.co.kr/*",
        "https://www.onch3.co.kr/*",
        "https://onch3.co.kr/*",
        "https://www.ownerclan.com/*",
        "https://ownerclan.com/*",
        "https://domeme.domeggook.com/*",
        "https://domemedb.domeggook.com/*"
      ],
      "js": [
        "domestic.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.tz1004.co.kr/Front/Acting/Delivery_W1.asp*",
        "https://tz1004.co.kr/Front/Acting/Delivery_W1.asp*"
      ],
      "js": [
        "tz1004.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
